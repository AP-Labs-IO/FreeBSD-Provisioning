#!/bin/sh

read -r LOG_LINE

if echo "$LOG_LINE" | grep -iq -E 'failed password|invalid user'
then
    HOSTNAME=$(hostname)

    TARGET_USER=$(echo "$LOG_LINE" | awk -F'from ' '{ print $1; }' | awk '{ print $NF; }')
    REMOTE_IP=$(echo "$LOG_LINE" | awk -F'from ' '{ print $2; }' | awk '{ print $1; }')

    /usr/local/bin/apprise \
        --config /root/.apprise.yml \
        --tag=security \
        --notification-type=WARNING \
        --title="SSH Login Failure on $HOSTNAME" \
        --body="Warning: Failed SSH connection attempt detected.\nUser: $TARGET_USER\nSource IP: $REMOTE_IP\nRaw Event: $LOG_LINE"
fi
