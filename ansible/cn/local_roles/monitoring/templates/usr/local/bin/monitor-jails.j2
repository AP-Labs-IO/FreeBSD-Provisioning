#!/bin/sh

HOSTNAME=$(hostname)


for jail in {{ monitoring_jails }}
do
    status=$(bastille list -uj $jail 2>/dev/null | jq length)
    if [ ${status:-0} -lt 1 ]
    then
        /usr/local/bin/apprise \
            --tag=services \
            --notification-type=FAILURE \
            --title="Jail Down Alert: $jail" \
            --body="Bastille jail '$jail' is offline or unreachable on host $HOSTNAME."
    fi
done
