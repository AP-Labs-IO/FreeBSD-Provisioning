global:
  logging:
    - type: stdout
      level: info
      format: human
      time: false

jobs:
{% for schedule in zfs_snapshotting_schedules %}
{% set prefix = schedule.prefix if schedule.prefix is defined else schedule.name ~ '_' %}
  - name: {{ schedule.name }}
    type: {{ schedule.type | default('push') }}
    connect:
      type: ssh+stdinserver
      host: {{ zfs_replication_target_host }}
      user: {{ zfs_replication_user.name }}
      port: {{ zfs_replication_target_port }}
      identity_file: /home/{{ zfs_replication_user.name }}/.ssh/{{ zfs_replication_key_basename }}
      options:
        - StrictHostKeyChecking=yes
    filesystems:
{% for dataset in schedule.datasets %}
      "{{ dataset }}": true
{% endfor %}
    snapshotting:
      type: {{ schedule.snapshotting | default('periodic') }}
      prefix: {{ prefix }}
      interval: {{ schedule.interval }}
    pruning:
      keep_sender:
{% if schedule.pruning.sender_raw is defined %}
{{ schedule.pruning.sender_raw | to_nice_yaml(indent=2) | indent(8, first=True) }}
{% else %}
        - type: not_replicated
        - type: grid
          grid: {{ schedule.pruning.sender_grid }}
          regex: "^{{ prefix }}"
{% endif %}
      keep_receiver:
{% if schedule.pruning.receiver_raw is defined %}
{{ schedule.pruning.receiver_raw | to_nice_yaml(indent=2) | indent(8, first=True) }}
{% else %}
        - type: grid
          grid: {{ schedule.pruning.receiver_grid }}
          regex: "^{{ prefix }}"
{% endif %}
{% endfor %}
