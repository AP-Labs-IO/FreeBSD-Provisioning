{% macro ssh_connect_block() %}
    connect:
      type: ssh+stdinserver
      host: {{ zfs_replication_target_host }}
      user: {{ zfs_replication_user.name }}
      port: {{ zfs_replication_target_port }}
      identity_file: /home/{{ zfs_replication_user.name }}/.ssh/{{ zfs_replication_key_basename }}
      options:
        - StrictHostKeyChecking=yes
{%- endmacro %}
global:
  logging:
    - type: stdout
      level: info
      format: human
      time: false

jobs:
  - name: hourly
    type: push
{{ ssh_connect_block() }}
    filesystems:
{% for dataset in zfs_hourly_snapshots_datasets %}
      "{{ dataset }}": true
{% endfor %}
    snapshotting:
      type: periodic
      prefix: hourly_
      interval: 1h
    pruning:
      keep_sender:
        - type: not_replicated
        - type: grid
          grid: 24x1h | 30x1d
          regex: "^hourly_"
      keep_receiver:
        - type: grid
          grid: 24x1h | 30x1d
          regex: "^hourly_"

  - name: daily
    type: push
{{ ssh_connect_block() }}
    filesystems:
{% for dataset in zfs_daily_snapshots_datasets %}
      "{{ dataset }}": true
{% endfor %}
    snapshotting:
      type: periodic
      prefix: daily_
      interval: 24h
    pruning:
      keep_sender:
        - type: not_replicated
        - type: grid
          grid: 30x1d
          regex: "^daily_"
      keep_receiver:
        - type: grid
          grid: 30x1d
          regex: "^daily_"
