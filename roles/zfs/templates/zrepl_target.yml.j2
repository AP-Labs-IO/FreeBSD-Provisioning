global:
  logging:
    - type: stdout
      level: info
      format: human
      time: false

jobs:
  - name: sink
    type: sink
    serve:
      type: stdinserver
      client_identities:
{% for host in (groups['all'] | difference([inventory_hostname])) %}
        - {{ hostvars[host]['ansible_facts']['hostname'] }}
{% endfor %}
    root_fs: {{ zfs_replication_target_dataset }}
    recv:
      placeholder:
        encryption: off
      properties:
        override:
          readonly: on
        inherit:
          - mountpoint
