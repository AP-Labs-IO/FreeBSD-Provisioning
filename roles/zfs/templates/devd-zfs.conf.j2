notify 10 {
    match "system"    "ZFS";
    match "type"      "ereport\.fs\.zfs\.(checksum|io|data|dio_verify_rd|dio_verify_wr|deadman)";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=WARNING \
        --title='ZFS I/O Error on $(hostname)' \
        --body='Warning: I/O error reported for pool $pool.\nDevice path: $vdev_path.\nError type: $type.'
    ";
};

notify 10 {
    match "system"    "ZFS";
    match "type"      "(resource\.fs\.zfs\.statechange|ereport\.fs\.zfs\.(vdev\..+|io_failure))";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS Pool State Change on $(hostname)' \
        --body='Critical: hardware state modified for pool $pool.\nDevice path: $vdev_path.\nEvent type: $type.'
    ";
};

notify 10 {
	match "system"		"ZFS";
	match "type"		"ereport.fs.zfs.probe_failure";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS Probe Failure on $(hostname)' \
        --body='Critical: vdev probe failure for pool $pool.\nDevice path: $vdev_path.'
    ";
};

notify 10 {
	match "system"		"ZFS";
	match "type"		"ereport.fs.zfs.vdev_spare";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=INFO \
        --title='ZFS Disk Replacement on $(hostname)' \
        --body='Info: spare disk activated in pool $pool.\nDevice path: $vdev_path.'
    ";
};

notify 10 {
	match "system"		"ZFS";
	match "type"		"ereport.fs.zfs.log_replay";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS Intent Log Failure on $(hostname)' \
        --body='Critical: ZFS Intent Log replay failure for pool $pool\nDevice path: $vdev_path.'
    ";
};

notify 10 {
    match "system"    "ZFS";
    match "type"      "ereport.fs.zfs.zpool";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS Pool Load Failure on $(hostname)' \
        --body='Critical: zpool $pool failed to import.'
    ";
};

notify 10 {
	match "system"		"ZFS";
	match "type"		"sysevent.fs.zfs.scrub_start";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=INFO \
        --title='ZFS Pool Scrub Start on $(hostname)' \
        --body='Info: scrub was started for pool $pool.'
    ";
};

notify 10 {
	match "system"		"ZFS";
	match "type"		"sysevent.fs.zfs.scrub_paused";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=INFO \
        --title='ZFS Pool Scrub Pause on $(hostname)' \
        --body='Info: scrub was paused for pool $pool.'
    ";
};

notify 10 {
    match "system"    "ZFS";
    match "type"      "ereport.fs.zfs.scrub_abort";
    action "{{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS Pool Scrub Abort on $(hostname)' \
        --body='Critical: scrub was aborted for pool $pool.'
    ";
};

notify 10 {
    match "system"    "ZFS";
    match "type"      "ereport.fs.zfs.scrub_finish";
    action "[ $scrub_errors -eq 0 ] && {{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=Info \
        --title='ZFS Pool Scrub Finish on $(hostname)' \
        --body='Info: scrub finished for pool $pool.'
    ";
};

notify 10 {
    match "system"    "ZFS";
    match "type"      "ereport.fs.zfs.scrub_finish";
    action "[ $scrub_errors -gt 0 ] && {{ ansible_facts['local_base'] }}/bin/apprise \
        --tag=zfs \
        --notification-type=FAILURE \
        --title='ZFS SCRUB COMPLETED WITH ERRORS' \
        --body='Critical: ZFS scrub completed with errors for pool $pool.\nScrub errors: $scrub_errors.'
    ";
};
