# PROVIDE: storage_pm
# REQUIRE: FILESYSTEMS

. /etc/rc.subr

name="storage_pm"
rcvar="storage_pm_enable"
start_cmd="storage_pm_start"

storage_pm_start() {
    echo "Applying storage power management configuration..."
    {{ host_tuning_installation_path }}/storage-pm
}

load_rc_config $name
run_rc_command "$1"
