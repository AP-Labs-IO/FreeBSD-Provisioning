#!/bin/sh

HOSTNAME=$(hostname)

zpool list -H -o name,cap | while read -r pool capacity
do
    capacity=$(echo "$capacity" | tr -d '%')
    if [ $capacity -ge {{ zfs_zpool_capacity_thresholds.critical }} ]
    then
        {{ ansible_facts['local_base'] }}/bin/apprise \
            --tag=zfs \
            --notification-type=WARNING \
            --title="ZFS Pool Critically Full: $pool ($capacity)" \
            --body="CRITICAL: Pool '$pool' usage has crossed the maximum {{ zfs_zpool_capacity_thresholds.critical }}% threshold on $HOSTNAME.\nCurrent allocation size: $capacity."
    elif [ $capacity -ge {{ zfs_zpool_capacity_thresholds.warning }} ]
    then
        {{ ansible_facts['local_base'] }}/bin/apprise \
            --tag=zfs \
            --notification-type=WARNING \
            --title="ZFS Pool Usage Warning: $pool ($capacity)" \
            --body="WARNING: Pool '$pool' usage has crossed the {{ zfs_zpool_capacity_thresholds.warning }}% threshold on $HOSTNAME.\nCurrent allocation size: $capacity."
    elif [ $capacity -ge {{ zfs_zpool_capacity_thresholds.notice }} ]
    then
        {{ ansible_facts['local_base'] }}/bin/apprise \
            --tag=zfs \
            --notification-type=INFO \
            --title="ZFS Pool Usage Notice: $pool ($capacity)" \
            --body="Notice: Pool '$pool' usage has crossed the {{ zfs_zpool_capacity_thresholds.notice }}% threshold on $HOSTNAME.\nCurrent allocation size: $capacity."
    fi
done
